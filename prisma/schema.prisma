generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  WAITING
  ACTIVE
  DONE
  CANCELLED
}

enum QueueStatus {
  WAITING
  ACTIVE
  DONE
}

enum AssignmentStrategy {
  AUTO_ASSIGN
  PATIENT_SELECTED
}

enum AssignmentReason {
  PRIMARY_DOCTOR
  AUTO_ASSIGNED
  PATIENT_SELECTED
  TEMPORARY_REPLACEMENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  // Doctor Capacity & Status
  status           String?   // e.g. "ACTIVE", "ON_LEAVE", "OFF_DUTY"
  isAvailable      Boolean   @default(true)
  maxDailyPatients Int       @default(20)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  appointments       Appointment[]   @relation("PatientAppointments")
  doctorAppointments Appointment[]   @relation("DoctorAppointments")
  doctorAvailability DoctorAvailability[] @relation("DoctorAvailability")

  // Relationships
  patientRelationships PatientDoctor[] @relation("PatientRelationships")
  doctorRelationships  PatientDoctor[] @relation("DoctorRelationships")
  doctorQueues         Queue[]         @relation("DoctorQueues")
}

model Hospital {
  id   String @id @default(uuid())
  name String

  departments Department[]
}

model Department {
  id                 String             @id @default(uuid())
  name               String
  hospitalId         String
  assignmentStrategy AssignmentStrategy @default(AUTO_ASSIGN)

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  appointments Appointment[]
  queues       Queue[]
  users        User[]
  patientDoctors PatientDoctor[]
}

model PatientDoctor {
  id           String   @id @default(uuid())
  patientId    String
  doctorId     String
  departmentId String
  isPrimary    Boolean  @default(true)
  assignedAt   DateTime @default(now())

  patient    User       @relation("PatientRelationships", fields: [patientId], references: [id], onDelete: Cascade)
  doctor     User       @relation("DoctorRelationships", fields: [doctorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([patientId, departmentId])
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  doctorId     String?
  departmentId String
  scheduledAt  DateTime
  duration     Int               @default(30) // in minutes
  description  String?           // patient's reason for visit
  doctorNotes  String?           // doctor's summary after visit
  status       AppointmentStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  // Assignment tracking
  assignmentReason      AssignmentReason?
  isTemporaryAssignment Boolean           @default(false)

  patient    User       @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor     User?      @relation("DoctorAppointments", fields: [doctorId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  queue      Queue?

  doctorAvailabilityId String? @unique
  doctorAvailability   DoctorAvailability? @relation(fields: [doctorAvailabilityId], references: [id])
  lastDayOfAppointment DateTime?
}

model Queue {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  doctorId      String
  departmentId  String
  scheduledAt   DateTime
  position      Int   
  status        QueueStatus @default(WAITING)
  createdAt     DateTime    @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  doctor      User        @relation("DoctorQueues", fields: [doctorId], references: [id])
  department  Department  @relation(fields: [departmentId], references: [id])

  @@unique([doctorId, scheduledAt, position])
}

model DoctorAvailability {
  id           String      @id @default(uuid())
  doctorId     String
  scheduledAt  DateTime
  duration     Int         @default(30)
  isBooked     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  doctor       User        @relation("DoctorAvailability", fields: [doctorId], references: [id], onDelete: Cascade)
  appointment  Appointment?

  @@unique([doctorId, scheduledAt])
}